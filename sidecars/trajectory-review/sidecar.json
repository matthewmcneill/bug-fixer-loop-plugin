{
  "builtin": "schedule",
  "args": [
    "<trajectory_review_cron>",
    "<plugin_dir>/scripts/trajectory_dispatcher.py"
  ],
  "restart_policy": "always",
  "display_name": "Bug Fixer Trajectory Review (<owner/repo>)",
  "description": "Checks for recent bug-fixer activity daily. Only spawns a review conversation if there is activity to review.",
  "agent_permissions": {
    "workspace_uris": [
      "file://<repo_dir>"
    ]
  },
  "env": {
    "PATH": "<path>",
    "BUG_FIXER_CONFIG": "<config_path>"
  }
}
