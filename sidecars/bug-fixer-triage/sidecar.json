{
  "builtin": "schedule",
  "args": [
    "<triage_cron>",
    "<plugin_dir>/scripts/triage_dispatcher.py"
  ],
  "restart_policy": "always",
  "display_name": "Bug Fixer Triage (<owner/repo>)",
  "description": "Checks for untriaged issues hourly. Only spawns an LLM conversation when there are issues to classify.",
  "agent_permissions": {
    "workspace_uris": [
      "file://<repo_dir>"
    ]
  },
  "env": {
    "PATH": "<path>",
    "BUG_FIXER_CONFIG": "<config_path>"
  }
}
