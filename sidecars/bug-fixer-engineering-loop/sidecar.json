{
  "builtin": "schedule",
  "args": [
    "<engineering_cron>",
    "<plugin_dir>/scripts/engineering_dispatcher.py"
  ],
  "restart_policy": "always",
  "display_name": "Bug Fixer Engineering (<owner/repo>)",
  "description": "Checks for eligible issues every 10 min. Only spawns an LLM conversation when there's actual work to do.",
  "agent_permissions": {
    "workspace_uris": [
      "file://<repo_dir>"
    ]
  },
  "env": {
    "PATH": "<path>",
    "BUG_FIXER_CONFIG": "<config_path>",
    "ANTIGRAVITY_PROJECT_ID": "<project_id>"
  }
}
