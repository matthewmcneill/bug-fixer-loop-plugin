{
  "bug-fixer-file-gate": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 <plugin_dir>/scripts/pre_tool_gate.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "bug-fixer-command-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 <plugin_dir>/scripts/pre_tool_gate.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "bug-fixer-url-gate": {
    "PreToolUse": [
      {
        "matcher": "read_url_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 <plugin_dir>/scripts/github_url_gate.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
