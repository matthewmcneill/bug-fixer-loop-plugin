{
  "$schema": "bug-fixer-loop-config-v1",
  "target_repo": "",
  "repo_dir": "",
  "maintainer": "",
  "trusted_users": [],
  "spec_file_path": "docs/design_specification.md",
  "protected_files": [
    "docs/design_specification.md"
  ],
  "leak_patterns": [
    "ya29\\.[A-Za-z0-9_-]+",
    "AKIA[0-9A-Z]{16}",
    "-----BEGIN (RSA |EC )?PRIVATE KEY-----"
  ],
  "max_concurrent_prs": 1,
  "exclusion_labels": [
    "human-required",
    "P1-blocker",
    "hardware-required"
  ],
  "auto_fixable_labels": [
    "auto-fixable"
  ],
  "auto_fixable_max_priority": "P3-docs-dx",
  "test_command": "pio test -e native",
  "lint_command": "",
  "pr_prefix": "[BugFixer]",
  "branch_prefix": "fix",
  "triage_cron": "0 * * * *",
  "tick_cron": "30 */2 * * *",
  "trajectory_review_cron": "0 18 * * *"
}
