{
  "$schema": "bug-fixer-loop-config-v2",
  "target_repo": "matthewmcneill/bug-fixer-loop-plugin",
  "maintainer": "matthewmcneill",
  "trusted_users": [],
  "spec_file_path": "docs/design_specification.md",
  "protected_files": [
    "docs/design_specification.md"
  ],
  "scanning": {
    "secrets": {
      "backend": "betterleaks",
      "patterns": [
        "ya29\\.[A-Za-z0-9_-]+",
        "AKIA[0-9A-Z]{16}",
        "-----BEGIN (RSA |EC )?PRIVATE KEY-----"
      ],
      "exclude_paths": []
    },
    "injection": {
      "enabled": false,
      "provider": "model_armor",
      "fail_open": true,
      "model_armor": {
        "project": "",
        "location": "us-central1",
        "service_account": ""
      }
    }
  },
  "max_concurrent_prs": 4,
  "exclusion_labels": [
    "bug-fixer:human:required",
    "P1-blocker",
    "hardware-required"
  ],
  "auto_fixable_labels": [
    "bug-fixer:engineer:needs-fix"
  ],
  "required_labels": [
    "bug-fixer:engineer:needs-fix",
    "bug-fixer:human:required",
    "bug-fixer:human:needs-approach-review",
    "bug-fixer:human:project-candidate",
    "bug-fixer:human:input-needed",
    "bug-fixer:engineer:in-progress",
    "bug-fixer:system:pr",
    "bug-fixer:system:health",
    "bug-fixer:human:spec-change-request",
    "bug-fixer:engineer:needs-iteration",
    "bug-fixer:architect:approved",
    "bug-fixer:architect:awaiting-review",
    "bug-fixer:human:needs-intervention",
    "bug-fixer:triage:discovered-in-review",
    "security:prompt-injection"
  ],
  "test_command": "python3 -m unittest discover -s tests -v",
  "lint_command": "",
  "pr_prefix": "[BugFixer]",
  "branch_prefix": "fix",
  "triage_cron": "0 * * * *",
  "engineering_cron": "*/10 * * * *",
  "architect_cron": "*/15 * * * *",
  "trajectory_review_cron": "0 18 * * *",
  "triage_model": "flash",
  "engineering_model": "pro",
  "architect_model": "pro",
  "trajectory_model": "flash",
  "milestone_priority_boost": true,
  "active_milestone": "",
  "additional_design_docs": []
}